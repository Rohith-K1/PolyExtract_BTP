# Copy to .env and fill in. Never commit .env.

# --- Literature discovery ---
# Contact email: used for the OpenAlex and Crossref "polite pools" (better rate limits).
OPENALEX_EMAIL=
# Free key from https://openalex.org/ (anonymous search is heavily throttled).
OPENALEX_API_KEY=
# Optional; falls back to OPENALEX_EMAIL.
CROSSREF_MAILTO=
# Web search provider: "ddgs" (DuckDuckGo, no key, best-effort) or "none".
WEB_SEARCH_PROVIDER=ddgs
WEB_SEARCH_API_KEY=

# --- LLM extraction (Phase 4) ---
# Provider:
#   anthropic  - official SDK, needs API credits (LLM_API_KEY). Models: claude-opus-5-5, claude-sonnet-5-5, claude-haiku-5-5
#   claude_cli - Claude Code `claude -p` under your Claude subscription login; no API key; usage-limited. Models: opus, sonnet, haiku
#   ollama     - free local model via Ollama (http://localhost:11434). Models: qwen2.5:7b (default), qwen2.5:3b (faster)
#   mock       - tests only; output labelled test_fixture, never verified
LLM_PROVIDER=mock
LLM_API_KEY=
# Empty = provider default (anthropic: claude-opus-5-5, claude_cli: opus, ollama: qwen2.5:7b).
LLM_MODEL=

# --- Paths (defaults shown) ---
POLYEXTRACT_DATA_DIR=data
LOG_LEVEL=INFO
